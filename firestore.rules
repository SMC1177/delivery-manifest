rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers -------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    // Org isolation: caller must have a member doc in the org.
    function isMember(orgSlug) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgSlug)/members/$(request.auth.uid));
    }
    function isAdmin(orgSlug) {
      return isSignedIn()
        && get(/databases/$(database)/documents/organizations/$(orgSlug)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles - users can read/write their own
    match /userProfiles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // An org admin may CREATE a profile for a staff member they are setting up
      // manually (SettingsPage handleManualAdd). Scoped to an org they administer:
      // isAdmin() does a get() on that org's members doc and requires role == 'admin'.
      allow create: if isSignedIn()
        && (request.auth.uid == userId || isAdmin(request.resource.data.orgSlug));
      allow update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Organizations
    match /organizations/{orgSlug} {
      // Org doc stays readable/creatable by any signed-in user:
      // JoinPage + SetupPage read it BEFORE membership exists.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Updates are org-internal (settings, branding, enabledFields).
      allow update: if isMember(orgSlug);

      // Members: self-create on join (AuthContext joinOrganization),
      // self-update for mfaEnrolled/welcomeDismissed; members read the
      // roster; admins manage other members.
      match /members/{memberId} {
        allow read: if isMember(orgSlug) || (isSignedIn() && request.auth.uid == memberId);
        allow create: if isAdmin(orgSlug);
        allow update: if (isSignedIn() && request.auth.uid == memberId) || isAdmin(orgSlug);
        allow delete: if isAdmin(orgSlug) || (isSignedIn() && request.auth.uid == memberId);
      }

      // Shipments (PHI) — org members only.
      match /facilities/{facilityId} {
        allow read, write: if isMember(orgSlug);
      }

      // Import runs - the companion record written after each import, read by the
      // Archive page. Undo runs through an Admin SDK callable, so no client delete.
      match /imports/{importId} {
        // Deliberately NOT `write`: that shorthand includes delete, and undo runs
        // through an Admin SDK callable that bypasses rules. Delete stays denied.
        allow read, create, update: if isMember(orgSlug);
      }

      match /shipments/{shipmentId} {
        allow read, write: if isMember(orgSlug);
      }

      // Deliveries (PHI) — org members only.
      // (Previously worked only via the deleted global catch-all.)
      match /deliveries/{deliveryId} {
        allow read, write: if isMember(orgSlug);
      }

      // Audit log — members read/append; never update/delete from clients.
      match /auditLog/{logId} {
        allow read: if isMember(orgSlug);
        allow create: if isMember(orgSlug);
      }

      // Invites — read/redeem happens BEFORE membership (JoinPage),
      // so those stay signed-in-level. Creation/deletion is member work.
      match /invites/{inviteId} {
        allow read, update: if isSignedIn();
        allow create, delete: if isMember(orgSlug);
      }

      // Settings docs (importConfig, textMessaging, ...) — members only.
      // Write stays member-level (ImportPage writes importConfig and its
      // role gating is unverified); tightening to admin is a follow-up.
      // Deep subcollections under settings (inboundSeen, usage) are
      // Cloud-Function-only and default-deny now: no rule matches them.
      match /settings/{settingDoc} {
        allow read, write: if isMember(orgSlug);
      }

      // SMS contacts — clients only ever READ (writes are Cloud Functions).
      match /smsContacts/{phone} {
        allow read: if isMember(orgSlug);
        allow write: if false;
      }
    }

    // Rate limiting — must work pre-authentication.
    match /loginAttempts/{email} {
      allow read, write: if true;
    }

    // platformAudit — admin-action + reconciliation audit trail.
    // Written ONLY by Cloud Functions (Admin SDK bypasses these rules).
    // Deny ALL client access. Effective now that no global catch-all exists.
    match /platformAudit/{entryId} {
      allow read, write: if false;
    }

    // Legacy v1 app — scoped to its actual data path
    // (main.js: /artifacts/{projectId}/public/data/manifest).
    // This replaces the old GLOBAL catch-all that exposed every
    // collection (including other orgs' PHI) to any signed-in user.
    // DO NOT widen this back to /{document=**}.
    match /artifacts/{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
