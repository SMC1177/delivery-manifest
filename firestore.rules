rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organizations
    match /organizations/{slug} {
      // Org doc itself — any authenticated member can read
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid));
      allow write: if false; // org docs are managed server-side only

      // Members subcollection — admin read/write; members can read their own doc
      match /members/{userId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId
            || get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role == 'admin');
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role == 'admin';
      }

      // Shipments — any authenticated org member can read; admin + staff can write
      match /shipments/{shipmentId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid));
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role in ['admin', 'staff'];
      }

      // Import config settings — admin only
      match /settings/importConfig {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role == 'admin';
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role == 'admin';
      }

      // Text messaging settings — admin read/write only (contains RC credentials)
      match /settings/textMessaging {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role == 'admin';
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role == 'admin';
      }

      // Daily usage counters under textMessaging — admin read; only Cloud Functions write
      match /settings/textMessaging/usage/{day} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role == 'admin';
        allow write: if false; // server-only
      }

      // Inbound dedupe tracker — server-only
      match /settings/textMessaging/inboundSeen/{messageId} {
        allow read, write: if false;
      }

      // smsContacts — admin + staff can read for the UI; only Cloud Functions write
      match /smsContacts/{phone} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/organizations/$(slug)/members/$(request.auth.uid)).data.role in ['admin', 'staff'];
        allow write: if false; // server-only
      }
    }

  }
}
