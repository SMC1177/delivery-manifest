{
  "name": "delivery-manifest-functions",
  "description": "Cloud Functions for delivery manifest",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "protobufjs"
    ]
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@google-cloud/secret-manager": "^6.1.2",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  }
}
